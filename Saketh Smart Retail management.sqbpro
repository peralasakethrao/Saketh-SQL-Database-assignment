bal_filter/></table><table schema="main" name="Inventory" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="57"/><column index="2" value="71"/><column index="3" value="94"/><column index="4" value="85"/><column index="5" value="126"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Products" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="69"/><column index="2" value="199"/><column index="3" value="78"/><column index="4" value="72"/><column index="5" value="65"/><column index="6" value="67"/><column index="7" value="81"/><column index="8" value="103"/><column index="9" value="87"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Stores" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="55"/><column index="2" value="247"/><column index="3" value="87"/><column index="4" value="231"/><column index="5" value="118"/><column index="6" value="87"/><column index="7" value="143"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Suppliers" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="70"/><column index="2" value="183"/><column index="3" value="111"/><column index="4" value="215"/><column index="5" value="87"/><column index="6" value="87"/><column index="7" value="94"/><column index="8" value="124"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT
    s.store_name,
    p.product_name,
    i.stock_quantity,
    i.reorder_level,
    CASE
        WHEN i.stock_quantity &lt; i.reorder_level
        THEN i.reorder_level - i.stock_quantity
        ELSE 0
    END AS replenishment_quantity
FROM Inventory i
JOIN Products p ON i.product_id = p.product_id
JOIN Stores s ON i.store_id = s.store_id
WHERE i.stock_quantity &lt;= i.reorder_level
ORDER BY replenishment_quantity DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
